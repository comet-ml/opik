{
  "name": "opik-genui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./ViewHost": {
      "types": "./dist/types/ViewHost.d.ts",
      "import": "./dist/ViewHost.js"
    },
    "./HtmlFrame": {
      "types": "./dist/types/HtmlFrame.d.ts",
      "import": "./dist/HtmlFrame.js"
    },
    "./contract": {
      "types": "./dist/types/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./tokens": {
      "types": "./dist/types/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./view": {
      "types": "./dist/types/view.d.ts",
      "import": "./dist/view.js"
    },
    "./libraries/vega.js": "./dist/libraries/vega.js",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css && npm run emit",
    "emit": "tsx scripts/emit.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.5.0"
  }
}

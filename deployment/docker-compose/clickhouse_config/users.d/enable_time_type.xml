<clickhouse>
    <!-- ClickHouse 25.8 made the experimental Time/Time64 type opt-in. Migration
         000030_add_project_configs_table creates a Time column (dropped later by 000036),
         so fresh installs need this enabled to replay the migration chain. This is a
         profile (users.d) setting, not a server (config.d) setting. -->
    <profiles>
        <default>
            <enable_time_time64_type>1</enable_time_time64_type>
            <!-- Makes toMonday / toStartOf* return Date32 / DateTime64 for wide (Date32 / DateTime64) inputs instead of
                 the year-2149-capped Date / year-2106-capped DateTime. traces_local_v2 (migration 000114) partitions by
                 toYYYYMMDD(toMonday(id_at)) over a DateTime64 id_at; this makes toMonday return Date32 so far-future bad
                 ids partition into an honest (obviously-bogus) YYYYMMDD instead of a wrapped-year one. Must be a server
                 default so it is active whenever data is inserted (OPIK-7456). Value-preserving no-op for all in-range
                 dates. -->
            <enable_extended_results_for_datetime_functions>1</enable_extended_results_for_datetime_functions>
        </default>
    </profiles>
</clickhouse>

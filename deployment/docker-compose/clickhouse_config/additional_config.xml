<clickhouse>
    <!-- Permits SQL_-prefixed custom settings (SQL_workspace_id / SQL_project_id) used by the Agent Insights
         read-only user's settings profile and row policies. Inert unless that user/profile is provisioned
         (dev-runner with TOGGLE_OLLIE_ENABLED=true, or prod via OPIK-6846). No effect otherwise. -->
    <custom_settings_prefixes>SQL_</custom_settings_prefixes>

    <!-- Mirrors conf.d/merge_tree.xml in the Helm chart's values.yaml, which explains the
         values; keep the two in step. Without these, LWD-masked rows are never reclaimed. -->
    <merge_tree>
        <max_bytes_to_merge_at_max_space_in_pool>429496729600</max_bytes_to_merge_at_max_space_in_pool>
        <min_age_to_force_merge_seconds>604800</min_age_to_force_merge_seconds>
        <min_age_to_force_merge_on_partition_only>0</min_age_to_force_merge_on_partition_only>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>8</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    </merge_tree>

    <macros>
        <shard>1</shard>
        <replica>clickhouse</replica>
        <cluster>cluster</cluster>
    </macros>
    
    <zookeeper>
        <node>
            <host>zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>
    
    <zookeeper_path>/clickhouse</zookeeper_path>
    <zookeeper_session_timeout_ms>30000</zookeeper_session_timeout_ms>
    
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>

    <!-- Mirrors the Helm cluster definition (clickhouse.shardsCount / replicasCount): one shard, one
         replica, internal_replication on. Compose runs a single replica, so internal_replication has
         nothing to fan out to and is a no-op here — it is set to keep the single-node cluster
         definition identical to the Kubernetes one, where Distributed inserts must hit one live
         replica and let ReplicatedMergeTree replicate the parts. -->
    <!-- The credentials complete the parity the block above claims, and without them this cluster cannot be used at
         all. A replica entry with no <user> authenticates as `default`, which the image's entrypoint removes whenever
         CLICKHOUSE_USER is set (users.d/default-user.xml) — and docker-compose.yaml sets it. That was latent while
         ClickHouse short-circuited the single local replica in-process, but users.d/distributed_insert_queue.xml now
         sets prefer_localhost_replica=0, which forces the network path, so every clusterAllReplicas('{cluster}', ...)
         and every Distributed read or write fails with AUTHENTICATION_FAILED. Deployed installs never hit it: the
         ClickHouse operator expands the chart's ClickHouseInstallation into a cluster definition with credentials of
         its own. Keep these matching docker-compose.yaml's CLICKHOUSE_USER / CLICKHOUSE_PASSWORD. -->
    <remote_servers>
        <cluster>
        <shard>
            <internal_replication>true</internal_replication>
            <replica>
            <host>clickhouse</host>
            <port>9000</port>
            <user>opik</user>
            <password>opik</password>
            </replica>
        </shard>
        </cluster>
    </remote_servers>
</clickhouse>